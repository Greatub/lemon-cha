{
  "manifest_version": 3,
  "name": "lemon cha",
  "description": "A lightweight browser AI chat workspace with custom LLM APIs, local Ollama, translation, and chat history.",
  "version": "0.2.4",
  "action": {
    "default_title": "lemon cha",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*",
    "https://dashscope.aliyuncs.com/*",
    "https://api.moonshot.ai/*",
    "https://api.siliconflow.cn/*",
    "https://api.groq.com/*"
  ]
}
