{
  "name": "lemon-cha",
  "version": "0.2.4",
  "private": true,
  "description": "lemon cha browser AI chat extension",
  "scripts": {
    "lint": "node scripts/validate.js",
    "lint:chrome": "node scripts/validate.js --target=chrome",
    "lint:firefox": "node scripts/validate.js --target=firefox",
    "typecheck": "node scripts/validate.js --syntax-only",
    "build": "node scripts/build-extension.js",
    "build:chrome": "node scripts/build-extension.js --target=chrome",
    "build:firefox": "node scripts/build-extension.js --target=firefox",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
